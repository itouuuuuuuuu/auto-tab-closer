{
  "name": "auto-tab-closer",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that automatically closes tabs you haven't looked at for a configurable number of hours.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
